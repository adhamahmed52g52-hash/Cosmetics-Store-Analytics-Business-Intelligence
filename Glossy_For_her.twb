    <worksheet name='P1_Insight'>
      <table>
        <view>
          <datasources>
            <datasource caption='vw_KpiMonthly' name='federated.13p3rhh10bmweu10ioejt0h8bvqn' />
            <datasource name='Parameters' />
            <datasource caption='vw_TrafficTicketMonthly' name='federated.0dbb7vm0sw1pod14okvrp0upddlr' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Partial Choice' datatype='string' name='[Parameter 0512987788853250]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include partial months&quot;'>
              <calculation class='tableau' formula='&quot;Include partial months&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dbb7vm0sw1pod14okvrp0upddlr'>
            <column caption='P4_Is_Partial' datatype='boolean' name='[Calculation_0799136378130434]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[year_month] = &quot;2025-11&quot; OR [year_month] = &quot;2026-09&quot;' />
            </column>
            <column caption='P4_Month_Label' datatype='string' name='[Calculation_0799136378322948]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0799136378130434] THEN [year_month] + &quot;*&quot; ELSE [year_month] END' />
            </column>
            <column-instance column='[Calculation_0799136378322948]' derivation='None' name='[none:Calculation_0799136378322948:nk]' pivot='key' type='nominal' />
            <column caption='Year Month' datatype='string' name='[year_month]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13p3rhh10bmweu10ioejt0h8bvqn'>
            <column caption='Month Type' datatype='string' name='[Calculation_0512987787825153]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_partial_month] = 1 THEN &quot;Partial&quot; &#13;&#10;ELSE &quot;Full&quot; END' />
            </column>
            <column caption='Month Label' datatype='string' name='[Calculation_0512987792728068]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_partial_month] = 1 THEN [year_month] + &quot; (partial)&quot; ELSE [year_month] END' />
            </column>
            <column caption='P1_Return Text' datatype='string' name='[Calculation_1248287287222291]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(ROUND(ABS(SUM([returns_value])) / SUM([gross_sales]) * 100, 2))' />
            </column>
            <column caption='P1_Sales Text' datatype='string' name='[Calculation_1248287288270869]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(INT(ROUND(SUM([net_sales]))/1000)) + &quot;,&quot; + RIGHT(&quot;000&quot; + STR(ROUND(SUM([net_sales])) % 1000), 3)' />
            </column>
            <column caption='P1_Margin Text' datatype='string' name='[Calculation_1248287288356886]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(ROUND(SUM([net_profit]) / SUM([net_sales]) * 100, 2))' />
            </column>
            <column caption='P1_First Full' datatype='string' name='[Calculation_1248287288508439]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ MIN(IF [is_partial_month] = 0 THEN [year_month] END) }' />
            </column>
            <column caption='P1_Last Full' datatype='string' name='[Calculation_1248287288614936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ MAX(IF [is_partial_month] = 0 THEN [year_month] END) }' />
            </column>
            <column caption='P1_Sales First' datatype='real' name='[Calculation_1248287288688665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ SUM(IF [year_month] = [Calculation_1248287288508439] THEN [net_sales] END) }' />
            </column>
            <column caption='P1_Sales Last' datatype='real' name='[Calculation_1248287288778778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ SUM(IF [year_month] = [Calculation_1248287288614936] THEN [net_sales] END) }' />
            </column>
            <column caption='P1_Trend Text' datatype='string' name='[Calculation_1248287288868891]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_1248287288508439]) OR [Calculation_1248287288508439] = [Calculation_1248287288614936] THEN &quot;&quot;&#13;&#10;ELSE &quot; | monthly net sales moved &quot; +&#13;&#10;     STR(ROUND(([Calculation_1248287288778778] - [Calculation_1248287288688665]) / [Calculation_1248287288688665] * 100, 1)) +&#13;&#10;     &quot;% from &quot; + [Calculation_1248287288508439] + &quot; to &quot; + [Calculation_1248287288614936] END' />
            </column>
            <column caption='P1_Subtitle' datatype='string' name='[Calculation_1248287288979484]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD([year_month]) = 1 THEN&#13;&#10;  MIN([Calculation_0512987792728068]) + &quot;: net sales &quot; + [Calculation_1248287288270869] + &quot; EGP at &quot; + [Calculation_1248287288356886] +&#13;&#10;  &quot;% margin; returns &quot; + [Calculation_1248287287222291] + &quot;% of gross sales&quot;&#13;&#10;ELSE&#13;&#10;  &quot;Net sales &quot; + [Calculation_1248287288270869] + &quot; EGP at &quot; + [Calculation_1248287288356886] +&#13;&#10;  &quot;% margin; returns are only &quot; + [Calculation_1248287287222291] + &quot;% of gross sales&quot; + MIN([Calculation_1248287288868891])&#13;&#10;END' />
            </column>
            <column caption='Show Month' datatype='boolean' name='[Calculation_1443999277375488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 0512987788853250] = &quot;Include partial months&quot; OR [Calculation_0512987787825153] = &quot;Full&quot;' />
            </column>
            <column caption='Gross Sales' datatype='real' name='[gross_sales]' role='measure' type='quantitative' />
            <column caption='Is Partial Month' datatype='integer' name='[is_partial_month]' role='dimension' type='quantitative' />
            <column caption='Net Profit' datatype='real' name='[net_profit]' role='measure' type='quantitative' />
            <column caption='Net Sales' datatype='real' name='[net_sales]' role='measure' type='quantitative' />
            <column caption='Net Sales Per Trading Day' datatype='real' name='[net_sales_per_trading_day]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_0512987792728068]' derivation='None' name='[none:Calculation_0512987792728068:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1443999277375488]' derivation='None' name='[none:Calculation_1443999277375488:nk]' pivot='key' type='nominal' />
            <column-instance column='[net_sales_per_trading_day]' derivation='None' name='[none:net_sales_per_trading_day:ok]' pivot='key' type='ordinal' />
            <column caption='Returns Value' datatype='real' name='[returns_value]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1248287288979484]' derivation='User' name='[usr:Calculation_1248287288979484:nk]' pivot='key' type='nominal' />
            <column caption='Year Month' datatype='string' name='[year_month]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.13p3rhh10bmweu10ioejt0h8bvqn].[Action (Month Type,Month Label)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action1_D40FC9A8E4A94752B77857C76F3DCA87]' user:ui-enumeration='all' user:ui-marker='enumerate'>
