            <groupfilter function='member' level='[none:Calculation_1248287259897866:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.15ucqxu0cywk6w1d0wlru17gylr0].[none:stock_status:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Healthy&quot;</bucket>
              <bucket>&quot;Slow&quot;</bucket>
              <bucket>&quot;Overstock&quot;</bucket>
