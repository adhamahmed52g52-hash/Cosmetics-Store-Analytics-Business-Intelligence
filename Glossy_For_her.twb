      <aliases enabled='yes' />
      <column caption='Low Margin' datatype='boolean' name='[Calculation_0188357204275200]' role='measure' type='nominal'>
        <calculation class='tableau' formula='AVG([margin_pct]) &lt; 10' />
      </column>
      <column caption='P2_ABC_Pct' datatype='real' name='[Calculation_1248287232184324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_revenue]) / TOTAL(SUM([net_revenue]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='P2_Cat Match' datatype='boolean' name='[Calculation_1248287259607048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1248287256379397] = &quot;All&quot; OR [product_category] = [Parameters].[Parameter 1248287256379397]' />
      </column>
      <column caption='P2_ABC Match' datatype='boolean' name='[Calculation_1248287259762697]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1248287259144199] = &quot;All&quot; OR [abc_class] = [Parameters].[Parameter 1248287259144199]' />
      </column>
      <column caption='P2_Scope Text' datatype='string' name='[Calculation_1248287284387855]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1248287256379397] &lt;&gt; &quot;All&quot; AND [Parameters].[Parameter 1248287259144199] &lt;&gt; &quot;All&quot; THEN [Parameters].[Parameter 1248287256379397] + &quot;, class &quot; + [Parameters].[Parameter 1248287259144199]&#13;&#10;ELSEIF [Parameters].[Parameter 1248287256379397] &lt;&gt; &quot;All&quot; THEN [Parameters].[Parameter 1248287256379397]&#13;&#10;ELSE &quot;Class &quot; + [Parameters].[Parameter 1248287259144199] END' />
      </column>
      <column caption='P2_Top Rank' datatype='integer' name='[Calculation_1248287284477968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ MIN(IF [Calculation_1248287259607048] AND [Calculation_1248287259762697] THEN [revenue_rank] END) }' />
      </column>
      <column caption='P2_Top Margin' datatype='real' name='[Calculation_1248287284559889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ SUM(IF [revenue_rank] = [Calculation_1248287284477968] THEN [net_profit] END) /&#13;&#10;  SUM(IF [revenue_rank] = [Calculation_1248287284477968] THEN [net_revenue] END) }' />
      </column>
      <column caption='P2_Subtitle' datatype='string' name='[Calculation_1248287284641810]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([Parameters].[Parameter 1248287256379397]) = &quot;All&quot; AND MIN([Parameters].[Parameter 1248287259144199]) = &quot;All&quot; THEN&#13;&#10;  &quot;Class A = &quot; + STR([Calculation_1443999357288456]) + &quot; SKUs (&quot; +&#13;&#10;  STR(ROUND([Calculation_1443999357288456] / [Calculation_1443999356334086] * 100, 0)) + &quot;% of &quot; + STR([Calculation_1443999356334086]) +&#13;&#10;  &quot; sold) drive 80% of revenue | the #1 product earns only &quot; + STR(ROUND(MIN([Calculation_1248287284559889]) * 100, 1)) +&#13;&#10;  &quot;% margin | Uncategorized = &quot; + STR(ROUND([Calculation_1443999360262156] * 100, 2)) + &quot;% of sales&quot;&#13;&#10;ELSE&#13;&#10;  MIN([Calculation_1248287284387855]) + &quot;: &quot; + STR([Calculation_1443999356334086]) + &quot; SKUs | revenue &quot; +&#13;&#10;  STR(ROUND(SUM([net_revenue]) / 1000, 1)) + &quot;K EGP (&quot; +&#13;&#10;  STR(ROUND(SUM([net_revenue]) / MIN({ SUM([net_revenue]) }) * 100, 1)) + &quot;% of total) | margin &quot; +&#13;&#10;  STR(ROUND(SUM([net_profit]) / SUM([net_revenue]) * 100, 1)) + &quot;% | #1 product margin &quot; +&#13;&#10;  STR(ROUND(MIN([Calculation_1248287284559889]) * 100, 1)) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='P2_Calc_SoldSKUs' datatype='integer' name='[Calculation_1443999356334086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([item_code])' />
      </column>
      <column caption='P2_Calc_InScopeBeauty' datatype='integer' name='[Calculation_1443999356444679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [product_scope] = &quot;In-Scope (Beauty)&quot; THEN [item_code] END)' />
      </column>
      <column caption='P2_Calc_ClassA_SKUs' datatype='integer' name='[Calculation_1443999357288456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [abc_class] = &quot;A&quot; THEN [item_code] END)' />
      </column>
      <column caption='P2_Calc_LossSKUs_Count' datatype='integer' name='[Calculation_1443999358464009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [net_profit] &lt; 0 THEN [item_code] END)' />
      </column>
      <column caption='P2_Calc_LossSKUs_TotalLoss' datatype='real' default-format='*-#,##0.00; -#,##0.00' name='[Calculation_1443999358623754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [net_profit] &lt; 0 THEN [net_profit] END)' />
      </column>
      <column caption='P2_Calc_Uncat_Share' datatype='real' default-format='p0.00%' name='[Calculation_1443999360262156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [product_category] = &quot;Uncategorized&quot; &#13;&#10;        THEN [net_revenue] END) /&#13;&#10;                                  SUM([net_revenue])' />
      </column>
      <column caption='P2_Calc_Uncat_Revenue' datatype='real' name='[Calculation_1443999360520205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [product_category] = &quot;Uncategorized&quot; THEN [net_revenue] END)' />
      </column>
      <column caption='P2_Calc_StoreWide_Margin' datatype='real' default-format='p0.00%' name='[Calculation_1443999361220622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_profit]) / SUM([net_revenue])' />
      </column>
