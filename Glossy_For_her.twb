      <aliases enabled='yes' />
      <column caption='P3_Healthy_Value' datatype='real' name='[Calculation_0188357229608961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [stock_status] = &quot;Healthy&quot; THEN [stock_value_at_cost] END)' />
      </column>
      <column caption='P3_Healthy_SKUs' datatype='integer' name='[Calculation_0188357229838338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [stock_status] = &quot;Healthy&quot; THEN [item_code] END)' />
      </column>
      <column caption='P3_Healthy_Pct' datatype='real' name='[Calculation_0188357229928451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0188357229608961] / SUM([stock_value_at_cost])' />
      </column>
      <column caption='P3_Dead_Value' datatype='real' name='[Calculation_0188357229989892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [stock_status] = &quot;Never sold&quot; OR [stock_status] = &quot;No sales 90d&quot; THEN [stock_value_at_cost] END)' />
      </column>
      <column caption='P3_Dead_Pct' datatype='real' name='[Calculation_0188357230088197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0188357229989892] / SUM([stock_value_at_cost])' />
      </column>
      <column caption='Last sale' datatype='string' name='[Calculation_0188357230239750]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([last_sale_date]) THEN &quot;never&quot;&#13;&#10; ELSE STR([last_sale_date]) END' />
      </column>
      <column caption='P3_Status_Pct' datatype='real' default-format='e0.00e+00' name='[Calculation_0188357243310096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stock_value_at_cost]) / TOTAL(SUM([stock_value_at_cost]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='P3_Cat Match' datatype='boolean' name='[Calculation_1248287259897866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1248287256379397] = &quot;All&quot; OR [product_category] = [Parameters].[Parameter 1248287256379397]' />
      </column>
      <column caption='P3_Status Match' datatype='boolean' name='[Calculation_1248287260020747]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1248287258271750] = &quot;All&quot; OR [stock_status] = [Parameters].[Parameter 1248287258271750]' />
      </column>
      <column caption='P3_Subtitle' datatype='string' name='[Calculation_1248287281852429]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1248287256379397] = &quot;All&quot; THEN &quot;&quot; ELSE [Parameters].[Parameter 1248287256379397] + &quot;: &quot; END +&#13;&#10;STR(ROUND([Calculation_0188357230088197] * 100, 0)) + &quot;% of stock value (&quot; +&#13;&#10;STR(ROUND([Calculation_0188357229989892] / 1000, 1)) + &quot;K EGP) has never sold or has no sales in 90 days&quot;' />
      </column>
      <column caption='P3_Top15 Match' datatype='boolean' name='[Calculation_1248287331360811]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1248287258271750] = &quot;All&quot; THEN [stock_status] = &quot;Overstock&quot; OR [stock_status] = &quot;No sales 90d&quot; OR [stock_status] = &quot;Never sold&quot;&#13;&#10;ELSE [stock_status] = [Parameters].[Parameter 1248287258271750] END' />
      </column>
