          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vw_InventoryHealth' name='federated.15ucqxu0cywk6w1d0wlru17gylr0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Category Choice' datatype='string' name='[Parameter 1248287256379397]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15ucqxu0cywk6w1d0wlru17gylr0'>
            <column caption='P3_Status_Pct' datatype='real' default-format='e0.00e+00' name='[Calculation_0188357243310096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stock_value_at_cost]) / TOTAL(SUM([stock_value_at_cost]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='P3_Cat Match' datatype='boolean' name='[Calculation_1248287259897866]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1248287256379397] = &quot;All&quot; OR [product_category] = [Parameters].[Parameter 1248287256379397]' />
            </column>
            <column-instance column='[Calculation_1248287259897866]' derivation='None' name='[none:Calculation_1248287259897866:nk]' pivot='key' type='nominal' />
            <column-instance column='[stock_status]' derivation='None' name='[none:stock_status:nk]' pivot='key' type='nominal' />
            <column caption='Category' datatype='string' name='[product_category]' role='dimension' type='nominal' />
            <column caption='Status' datatype='string' name='[stock_status]' role='dimension' type='nominal' />
            <column caption='Value (EGP)' datatype='real' name='[stock_value_at_cost]' role='measure' type='quantitative' />
            <column-instance column='[stock_value_at_cost]' derivation='Sum' name='[sum:stock_value_at_cost:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0188357243310096]' derivation='User' name='[usr:Calculation_0188357243310096:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
          </datasource-dependencies>
