      <aliases enabled='yes' />
      <column caption='P4_Day_Class' datatype='string' name='[Calculation_0799136378691590]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sales_per_trading_day] = { MAX([sales_per_trading_day]) } THEN &quot;Best&quot;&#13;&#10;ELSEIF [sales_per_trading_day] = { MIN([sales_per_trading_day]) } THEN &quot;Worst&quot;&#13;&#10;ELSE &quot;Other&quot; END' />
      </column>
      <column caption='P4_Best Day' datatype='string' name='[Calculation_1248287303413796]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ MAX(IF [sales_per_trading_day] = { MAX([sales_per_trading_day]) } THEN [weekday_name] END) }' />
      </column>
      <column caption='P4_Worst Day' datatype='string' name='[Calculation_1248287303471141]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ MAX(IF [sales_per_trading_day] = { MIN([sales_per_trading_day]) } THEN [weekday_name] END) }' />
      </column>
      <column caption='P4_Gap Text' datatype='string' name='[Calculation_1248287303602214]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1248287303413796] + &quot; sells &quot; +&#13;&#10;STR(ROUND(({ MAX([sales_per_trading_day]) } / { MIN([sales_per_trading_day]) } - 1) * 100, 0)) +&#13;&#10;&quot;% more per day than &quot; + [Calculation_1248287303471141] + &quot; (all months)&quot;' />
      </column>
