    <worksheet name='P4_Insight '>
      <table>
        <view>
          <datasources>
            <datasource caption='vw_TrafficTicketMonthly' name='federated.0dbb7vm0sw1pod14okvrp0upddlr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Partial Choice' datatype='string' name='[Parameter 0512987788853250]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include partial months&quot;'>
              <calculation class='tableau' formula='&quot;Include partial months&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dbb7vm0sw1pod14okvrp0upddlr'>
            <column caption='P4_Is_Partial' datatype='boolean' name='[Calculation_0799136378130434]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[year_month] = &quot;2025-11&quot; OR [year_month] = &quot;2026-09&quot;' />
            </column>
            <column caption='P4_Month_Label' datatype='string' name='[Calculation_0799136378322948]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0799136378130434] THEN [year_month] + &quot;*&quot; ELSE [year_month] END' />
            </column>
            <column caption='P4_Show_Month' datatype='boolean' name='[Calculation_0799136378437637]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 0512987788853250] = &quot;Include partial months&quot; OR NOT [Calculation_0799136378130434]' />
            </column>
            <column caption='P4_First Full' datatype='string' name='[Calculation_1248287292354589]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ MIN(IF NOT [Calculation_0799136378130434] THEN [year_month] END) }' />
            </column>
            <column caption='P4_Last Full' datatype='string' name='[Calculation_1248287292456990]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ MAX(IF NOT [Calculation_0799136378130434] THEN [year_month] END) }' />
            </column>
            <column caption='P4_IPD First' datatype='real' name='[Calculation_1248287292534815]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ SUM(IF [year_month] = [Calculation_1248287292354589] THEN [invoices] END) /&#13;&#10;  SUM(IF [year_month] = [Calculation_1248287292354589] THEN [trading_days] END) }' />
            </column>
            <column caption='P4_IPD Last' datatype='real' name='[Calculation_1248287292616736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ SUM(IF [year_month] = [Calculation_1248287292456990] THEN [invoices] END) /&#13;&#10;  SUM(IF [year_month] = [Calculation_1248287292456990] THEN [trading_days] END) }' />
            </column>
            <column caption='P4_UPI First' datatype='real' name='[Calculation_1248287292866593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ SUM(IF [year_month] = [Calculation_1248287292354589] THEN [units_per_invoice] END) }' />
            </column>
            <column caption='P4_UPI Last' datatype='real' name='[Calculation_1248287292940322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ SUM(IF [year_month] = [Calculation_1248287292456990] THEN [units_per_invoice] END) }' />
            </column>
            <column caption='P4_Subtitle' datatype='string' name='[Calculation_1248287293059107]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD([year_month]) = 1 THEN&#13;&#10;  MIN([Calculation_0799136378322948]) + &quot;: &quot; + STR(ROUND(SUM([invoices]) / SUM([trading_days]), 1)) +&#13;&#10;  &quot; invoices per trading day, &quot; + STR(ROUND(SUM([units_per_invoice]), 2)) +&#13;&#10;  &quot; units per invoice, avg unit price &quot; + STR(ROUND(SUM([avg_unit_price]), 1)) + &quot; EGP&quot;&#13;&#10;ELSE&#13;&#10;  &quot;Daily invoices moved from &quot; + STR(ROUND(MIN([Calculation_1248287292534815]), 1)) + &quot; (&quot; + MIN([Calculation_1248287292354589]) + &quot;) to &quot; +&#13;&#10;  STR(ROUND(MIN([Calculation_1248287292616736]), 1)) + &quot; (&quot; + MIN([Calculation_1248287292456990]) + &quot;); units per invoice &quot; +&#13;&#10;  STR(ROUND(MIN([Calculation_1248287292866593]), 2)) + &quot; → &quot; + STR(ROUND(MIN([Calculation_1248287292940322]), 2))&#13;&#10;END' />
            </column>
            <column caption='Avg Unit Price' datatype='real' name='[avg_unit_price]' role='measure' type='quantitative' />
            <column caption='Invoices' datatype='integer' name='[invoices]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0799136378322948]' derivation='None' name='[none:Calculation_0799136378322948:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0799136378437637]' derivation='None' name='[none:Calculation_0799136378437637:nk]' pivot='key' type='nominal' />
            <column caption='Trading Days' datatype='integer' name='[trading_days]' role='measure' type='quantitative' />
            <column caption='Units Per Invoice' datatype='real' name='[units_per_invoice]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1248287293059107]' derivation='User' name='[usr:Calculation_1248287293059107:nk]' pivot='key' type='nominal' />
            <column caption='Year Month' datatype='string' name='[year_month]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0dbb7vm0sw1pod14okvrp0upddlr].[Action (Year Month)]'>
            <groupfilter function='level-members' level='[year_month]' user:ui-action-filter='[Action9_FFC8663FEE7A41118E6EBB9BD0AB3830]' user:ui-enumeration='all' user:ui-marker='enumerate' />
