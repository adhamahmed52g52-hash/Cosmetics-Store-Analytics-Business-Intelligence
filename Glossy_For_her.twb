              <calculation class='tableau' formula='IF ATTR([Calculation_1443999289774081]) = &quot;Total&quot; THEN 0 &#13;&#10;ELSE LOOKUP(SUM([Pivot Field Values]), -1) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WF Size' datatype='real' name='[Calculation_1248287228239873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Calculation_1443999289774081]) = &quot;Total&quot; THEN SUM([Pivot Field Values]) &#13;&#10;ELSE -ABS(SUM([Pivot Field Values])) END' />
            </column>
            <column caption='Step Type' datatype='string' name='[Calculation_1443999289774081]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([Pivot Field Names]), &quot;non&quot;) OR CONTAINS(LOWER([Pivot Field Names]), &quot;return&quot;) THEN &quot;Deduction&quot;&#13;&#10; ELSE &quot;Total&quot; END' />
